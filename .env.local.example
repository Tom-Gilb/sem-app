# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored and must never be committed.

# ── AI provider selection ──────────────────────────────────────────────────
# Three modes (highest priority first):
#
#   1. Local Claude Code  (RECOMMENDED — uses Tom's Claude Code OAuth, no
#                          per-call API key, matches the Claude-Code-as-AI-
#                          Layer Rule in vault CLAUDE.md):
#         VITE_AI_PROVIDER=claude-code
#         # Requires `claude` CLI on PATH. Run `which claude` to verify.
#         # All AI calls route through src/lib/claudeCodeAdapter.ts via the
#         # /api/claude-code Vite middleware, which spawns `claude -p`.
#
#   2. Local Ollama  (no internet, no API key, lower quality):
#         VITE_OLLAMA_MODEL=llama3.1:8b
#         VITE_OLLAMA_BASE_URL=http://localhost:11434
#
#   3. External Anthropic API  (legacy — drains a per-call billed API key):
#         VITE_ANTHROPIC_API_KEY=sk-ant-...
#         # Banned for new features per CLAUDE.md (2026-06-02). Kept here only
#         # for back-compat with shipped composables.
#
# If multiple are set: claude-code > Ollama > Anthropic API.

VITE_AI_PROVIDER=claude-code

# Optional — override the /api/claude-code middleware URL (rarely needed):
# VITE_CLAUDE_CODE_URL=/api/claude-code

# Legacy API key (only used if VITE_AI_PROVIDER is unset and Ollama is unset):
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Supabase project keys — get these from your Supabase dashboard
# Project Settings → API → Project URL and anon/public key
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Set to 'true' to use mock data without a real Anthropic API key
VITE_MOCK_MODE=false
