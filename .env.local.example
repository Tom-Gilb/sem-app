# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored and must never be committed.

# Anthropic API key for the CE translation pipeline
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Supabase project keys — get these from your Supabase dashboard
# Project Settings → API → Project URL and anon/public key
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Set to 'true' to use mock data without a real Anthropic API key
VITE_MOCK_MODE=false
